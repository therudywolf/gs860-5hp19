  "gate": {
   "en": "Left gate: S first, M on the first +/- tap (code 0xFE, BMW factory) instead of M at once (0x0B).",
   "ru": "Кулиса: сначала S, M по первому нажатию +/- (код 0xFE, как у BMW) вместо сразу M (0x0B)."
  },
  "s-no5": {
   "en": "S without 5th: 4>5 never in k11 / k15, 5>4 lands at most 500 rpm under the spark cut, AGS points in S held at 193 or more (level 4, no PF / hill step 2 in S).",
   "ru": "S без 5-й: 4>5 никогда в k11 / k15, 5>4 с посадкой не ближе 500 об/мин к искре, очки AGS в S от 193 (уровень 4, без PF и горной ступени 2 в S)."
  },
  "shift-wot": {
   "en": "Full-throttle upshifts (pedal 243-255) under the spark cut by docs 02 §4, locked addition of 20C0 subtracted; downshifts kept under the upshifts and under the spark cut.",
   "ru": "Повышения в пол (педаль 243-255) под искру по документу 02 §4 с вычетом прибавки 20C0 при замкнутой ГДТ; понижения ниже повышений и ниже искры."
  },
  "tcc-lock": {
   "en": "Torque converter locked early and with any pedal in gears 2-5 (lock 1600, slip 1215, open 1088 rpm turbine, the WOLF4X v25 values), never later than the factory.",
   "ru": "ГДТ замкнута рано и при любой педали во 2-5-й (замыкание 1600, скольжение 1215, размыкание 1088 об/мин турбины, значения WOLF4X v25), не позже завода."
  },
  "tcc-first": {
   "en": "Torque converter locked in 1st gear under throttle (lock 1760 rpm turbine S/M, 2110 D, later with more pedal; opens at once with the pedal released).",
   "ru": "ГДТ на 1-й под газом (замыкание 1760 об/мин турбины S/M, 2110 D, позже с ростом педали; с отпущенной педалью размыкается сразу)."
  },
  "manual-hold": {
   "en": "M holds the gear on the limiter: up only on the overrun above the hard cut, under the turbine monitor; the kickdown row does not downshift in M.",
   "ru": "M держит передачу на отсечке: повышение только на накате выше отсечки и ниже монитора турбины; строка кикдауна в M не понижает."
  },
  "no-kickdown": {
   "en": "Kickdown off: the flag is never set (switch path with pedal > 255); in M the +/- taps work with the pedal on the floor.",
   "ru": "Кикдаун выключен: флаг не ставится никогда (ветка контакта с педалью > 255); в M нажатия +/- работают с педалью в полу."
  },
  "no-warmup": {
   "en": "Warm-up program off: it ends on the first cycle after power-on.",
   "ru": "Режим прогрева выключен: заканчивается на первом такте после включения."
  }
